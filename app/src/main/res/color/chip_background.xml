<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Distinct 28% container tint when checked -->
    <item android:alpha="0.28" android:color="?attr/primaryOrTextPrimary" android:state_enabled="true" android:state_selected="true" />
    <item android:alpha="0.28" android:color="?attr/primaryOrTextPrimary" android:state_checked="true" android:state_enabled="true" />
    <!-- Subtle container fill when unchecked -->
    <item android:alpha="0.08" android:color="?attr/colorOnSurface" android:state_enabled="true" />
    <item android:alpha="0.08" android:color="?attr/colorOnSurface" />
</selector>
