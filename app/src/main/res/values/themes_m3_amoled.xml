<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- M3 Expressive AMOLED Overlay Themes -->
    
    <!-- Base AMOLED overlay (applied on top of dark theme) -->
    <style name="Theme.Throne.M3.Amoled" parent="Theme.Throne.M3">
        <!-- True black surfaces -->
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#0A0A0A</item>
        <item name="colorSurfaceContainer">#121212</item>
        <item name="colorSurfaceContainerHigh">#1A1A1A</item>
        <item name="colorSurfaceContainerHighest">#222222</item>
        
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnSurfaceVariant">#B0B0B0</item>
        
        <item name="colorOutline">#333333</item>
        <item name="colorOutlineVariant">#2A2A2A</item>
        
        <item name="colorSurfaceTint">@color/m3_sys_primary</item>
        
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">#000000</item>
    </style>
    
    <!-- AMOLED White theme fallback (White theme at night becomes black) -->
    <style name="Theme.Throne.M3.Amoled.White" parent="Theme.Throne.M3.Amoled">
        <item name="colorPrimary">#757575</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#424242</item>
        <item name="colorOnPrimaryContainer">#FFFFFF</item>
        
        <item name="colorSecondary">#616161</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#424242</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>
        
        <item name="colorSurface">#000000</item>
        <item name="colorOnSurface">#FFFFFF</item>
    </style>
    
    <!-- Dialog AMOLED -->
    <style name="Theme.Throne.M3.Dialog.Amoled" parent="Theme.Throne.M3.Dialog">
        <item name="colorSurface">#000000</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorSurfaceVariant">#1A1A1A</item>
        <item name="colorOnSurfaceVariant">#B0B0B0</item>
        <item name="colorOutline">#333333</item>
    </style>
</resources>