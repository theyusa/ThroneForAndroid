<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- M3 Expressive Elevation Levels -->
    <!-- Level 0 - Flat surfaces, no shadow -->
    <dimen name="m3_sys_elevation_level0">0dp</dimen>
    
    <!-- Level 1 (4dp) - Cards, Search bars, Chips (hover) -->
    <dimen name="m3_sys_elevation_level1">4dp</dimen>
    
    <!-- Level 2 (8dp) - FAB (resting), Bottom navigation bar, Side navigation -->
    <dimen name="m3_sys_elevation_level2">8dp</dimen>
    
    <!-- Level 3 (12dp) - Dialogs, Bottom sheets (modal), Menus, Tooltips -->
    <dimen name="m3_sys_elevation_level3">12dp</dimen>
    
    <!-- Level 4 (16dp) - Modal bottom sheets, Navigation drawer -->
    <dimen name="m3_sys_elevation_level4">16dp</dimen>
    
    <!-- Level 5 (24dp) - Snackbars, Toasts, Full-screen modals -->
    <dimen name="m3_sys_elevation_level5">24dp</dimen>
    
    <!-- Component-specific elevations -->
    <dimen name="m3_elevation_card_rest">@dimen/m3_sys_elevation_level1</dimen>
    <dimen name="m3_elevation_card_hover">@dimen/m3_sys_elevation_level2</dimen>
    <dimen name="m3_elevation_card_drag">@dimen/m3_sys_elevation_level3</dimen>
    
    <dimen name="m3_elevation_fab_rest">@dimen/m3_sys_elevation_level2</dimen>
    <dimen name="m3_elevation_fab_hover">@dimen/m3_sys_elevation_level3</dimen>
    <dimen name="m3_elevation_fab_press">@dimen/m3_sys_elevation_level1</dimen>
    
    <dimen name="m3_elevation_bottom_sheet">@dimen/m3_sys_elevation_level3</dimen>
    <dimen name="m3_elevation_modal_bottom_sheet">@dimen/m3_sys_elevation_level4</dimen>
    
    <dimen name="m3_elevation_dialog">@dimen/m3_sys_elevation_level3</dimen>
    
    <dimen name="m3_elevation_navigation_bar">@dimen/m3_sys_elevation_level2</dimen>
    <dimen name="m3_elevation_navigation_drawer">@dimen/m3_sys_elevation_level4</dimen>
    
    <dimen name="m3_elevation_menu">@dimen/m3_sys_elevation_level3</dimen>
    <dimen name="m3_elevation_tooltip">@dimen/m3_sys_elevation_level3</dimen>
    <dimen name="m3_elevation_snackbar">@dimen/m3_sys_elevation_level5</dimen>
    
    <!-- Search bar -->
    <dimen name="m3_elevation_search_bar">@dimen/m3_sys_elevation_level1</dimen>
    <dimen name="m3_elevation_search_bar_scrolled">@dimen/m3_sys_elevation_level2</dimen>
    
    <!-- App bar -->
    <dimen name="m3_elevation_app_bar">@dimen/m3_sys_elevation_level1</dimen>
    <dimen name="m3_elevation_app_bar_scrolled">@dimen/m3_sys_elevation_level2</dimen>
</resources>