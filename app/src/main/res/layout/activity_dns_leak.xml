<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Hero Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_soft">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_baseline_security_24"
                        app:tint="?attr/primaryOrTextPrimary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textHeroTitle"
                        style="@style/TextAppearance.MaterialComponents.Headline5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tools_dns_leak"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textHeroSubtitle"
                        style="@style/TextAppearance.MaterialComponents.Body2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/tools_dns_leak_summary"
                        android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Diagnostic Verdict Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVerdict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imageVerdictIcon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_baseline_check_circle_24"
                            app:tint="?attr/primaryOrTextPrimary" />

                        <TextView
                            android:id="@+id/badgeVerdict"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_badge_soft"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:textStyle="bold"
                            tools:text="SECURE (No Leak)" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textVerdictTitle"
                        style="@style/TextAppearance.MaterialComponents.Headline6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textStyle="bold"
                        tools:text="DNS Queries Protected" />

                    <TextView
                        android:id="@+id/textVerdictDesc"
                        style="@style/TextAppearance.MaterialComponents.Body2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="?android:attr/textColorSecondary"
                        tools:text="All DNS queries are safely routed through your VPN tunnel. Zero ISP leak detected." />

                    <!-- Recommendation Box -->
                    <LinearLayout
                        android:id="@+id/layoutRecommendation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_badge_soft"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="top"
                            android:layout_marginTop="1dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_baseline_info_24"
                            app:tint="?attr/primaryOrTextPrimary" />

                        <TextView
                            android:id="@+id/textRecommendation"
                            style="@style/TextAppearance.MaterialComponents.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="?android:attr/textColorSecondary"
                            tools:text="Your current connection setup is completely secure against DNS leaks." />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stage 1: Fake-IP Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFakeIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.MaterialComponents.Subtitle1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/dns_leak_fakeip_card_title"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/badgeFakeIp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_soft"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:textAppearance="?attr/textAppearanceCaption"
                            tools:text="Active (198.18.0.0/15)" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textFakeIpSummary"
                        style="@style/TextAppearance.MaterialComponents.Body2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="?android:attr/textColorSecondary"
                        tools:text="Fake-IP mode is active. Domains are intercepted and synthesized locally; zero DNS queries leave your device unencrypted." />

                    <LinearLayout
                        android:id="@+id/layoutFakeIpSamples"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stage 2: Client Public Egress Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.MaterialComponents.Subtitle1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/dns_leak_egress_card_title"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/badgeWarp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_soft"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:visibility="gone"
                            tools:text="WARP"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textEgressIp"
                            style="@style/TextAppearance.MaterialComponents.Headline6"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:textIsSelectable="true"
                            tools:text="185.157.217.124" />

                        <ImageButton
                            android:id="@+id/btnCopyEgressIp"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/network_interfaces_copy_hint"
                            android:src="@drawable/ic_content_copy"
                            app:tint="?attr/primaryOrTextPrimary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textEgressLocation"
                        style="@style/TextAppearance.MaterialComponents.Body2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?android:attr/textColorSecondary"
                        tools:text="Location: Turkey (TR)" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stage 3: DNS Resolver Egress Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResolver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.MaterialComponents.Subtitle1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/dns_leak_resolver_card_title"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/badgeResolverStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_soft"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:textAppearance="?attr/textAppearanceCaption"
                            tools:text="EDNS Probe" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textResolverIp"
                            style="@style/TextAppearance.MaterialComponents.Headline6"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:textIsSelectable="true"
                            tools:text="104.22.145.72" />

                        <ImageButton
                            android:id="@+id/btnCopyResolverIp"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/network_interfaces_copy_hint"
                            android:src="@drawable/ic_content_copy"
                            app:tint="?attr/primaryOrTextPrimary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textResolverGeo"
                        style="@style/TextAppearance.MaterialComponents.Body2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?android:attr/textColorSecondary"
                        tools:text="ISP / Geo: Turkey - Cloudflare, Inc." />

                    <TextView
                        android:id="@+id/textResolverNote"
                        style="@style/TextAppearance.MaterialComponents.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="?android:attr/textColorSecondary"
                        tools:text="Authoritative recursive resolver observed when querying nonce domain." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stage 4: System & Private DNS Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSystemDns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.MaterialComponents.Subtitle1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dns_leak_system_dns_card_title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textSystemDnsSummary"
                        style="@style/TextAppearance.MaterialComponents.Body2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        tools:text="Active DNS: 172.19.0.2 (tun0)" />

                    <TextView
                        android:id="@+id/textPrivateDns"
                        style="@style/TextAppearance.MaterialComponents.Body2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?android:attr/textColorSecondary"
                        tools:text="Private DNS (DoT): Not active" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRerunTest"
                style="@style/Widget.SagerNet.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingVertical="12dp"
                android:text="@string/start_dns_leak_test"
                app:icon="@drawable/ic_baseline_refresh_24"
                app:iconGravity="textStart" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
